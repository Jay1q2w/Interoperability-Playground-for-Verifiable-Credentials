{
  "name": "inji-interop-playground-backend",
  "version": "1.0.0",
  "description": "BFF and Interoperability Protocol Orchestrator for Inji OpenID4VCI & OpenID4VP Playground",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean:port": "powershell -Command \"Get-NetTCPConnection -LocalPort 4000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\"",
    "test": "jest --config jest.config.cjs --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "ws": "^8.18.0",
    "uuid": "^9.0.1",
    "jose": "^5.9.6",
    "cbor-x": "^1.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^20.17.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.13",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
